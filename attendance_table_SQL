-- Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS bright.attendance;

-- Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.attendance.table;

-- Step 4: Create a Table
CREATE TABLE IF NOT EXISTS bright.attendance.table (
    student_ID INT,
    day_present INT,
    total_days INT
    );

-- Step 5: Insert the information into the table
INSERT INTO bright.attendance.table VALUES 
(1, 45, 50),
(2, 30, 50),
(3, 48, 50),
(4, 25, 50),
(5, 50, 50);

-- Step 6: Check if the table was created correctly
SELECT *
FROM bright.attendance.table;

SELECT
    student_ID,
    day_present,
    total_days,
    CONCAT(
        ROUND((day_present * 100.0) / total_days, 1),
        '%'
    ) AS attendance_percentage,
    CASE
        WHEN (day_present * 100.0) / total_days >= 90 THEN 'Excellent'
        WHEN (day_present * 100.0) / total_days >= 75 THEN 'Good'
        ELSE 'Needs Improvement'
    END AS attendance_status
FROM bright.attendance.table;
