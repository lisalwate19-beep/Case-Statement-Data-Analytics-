-- Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS bright.class;

-- Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.class.table;

-- Step 4: Create a Table
CREATE TABLE IF NOT EXISTS bright.class.table (
    class_ID INT,
    subject STRING,
    enrolled_students INT
    
    );

-- Step 5: Insert the information into the table
INSERT INTO bright.class.table VALUES 
(1, 'Math', 30),
(2, 'English', 25),
(3, 'Science', 15),
(4,  'Art', 5),
(5, 'History', 20);

-- Step 6: Check if the table was created correctly
SELECT *
FROM bright.class.table;

SELECT
    class_id,
    subject,
    enrolled_students,
    CASE
        WHEN enrolled_students >= 25 THEN 'Large'
        WHEN enrolled_students BETWEEN 10 AND 24 THEN 'Medium'
        WHEN enrolled_students < 10 THEN 'Small'
    END AS class_size_category
FROM bright.class.table;
