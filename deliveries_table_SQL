-- Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS bright.deliveries;

-- Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.deliveries.table;

-- Step 4: Create a Table
CREATE TABLE IF NOT EXISTS bright.deliveries.table (
    delivery_ID INT,
    delivery_time_minutes INT
);

-- Step 5: Insert the information into the table
INSERT INTO bright.deliveries.table VALUES
(1, 45),
(2, 80),
(3, 30),
(4, 65),
(5, 100);

-- Step 6: Check if the table was created correctly
SELECT *
FROM bright.deliveries.table;


SELECT
    delivery_id,
    delivery_time_minutes,
    CASE
        WHEN delivery_time_minutes <= 30 THEN 'Fast'
        WHEN delivery_time_minutes BETWEEN 31 AND 60 THEN 'On Time'
        WHEN delivery_time_minutes > 60 THEN 'Late'
    END AS performance
FROM bright.deliveries.table;
