--Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

--Step 2: Creat a Schema 
CREATE SCHEMA IF NOT EXISTS bright.product;

--Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.product.table;

--Step 4: Create a Table 
CREATE TABLE IF NOT EXISTS bright.product.table (
product_ID INT,
product_name STRING,
price STRING
);

--Step 5: Insert the information into the table 
INSERT INTO bright.product.table VALUES
(1, 'Laptop',1200),
(2, 'Phone', 800),
(3, 'Keyboard', 45),
(4, 'Monitor', 300),
(5, 'Mouse', 25);

--Step 6: Check if the table is created correctly
SELECT*
FROM bright.product.table;

SELECT product_name,
price
 product_name,
    price,
    CASE
        WHEN price > 1000 THEN 'Expensive'
        WHEN price BETWEEN 100 AND 1000 THEN 'Mid-range'
        WHEN price < 100 THEN 'Budget'
    END AS price_category
FROM bright.product.table;
