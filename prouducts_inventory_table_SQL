-- Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS bright.product_inventory;

-- Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.product_inventory.table;

-- Step 4: Create a Table
CREATE TABLE IF NOT EXISTS bright.product_inventory.table (
    product_ID INT,
    stock_qty INT
    
    );

-- Step 5: Insert the information into the table
INSERT INTO bright.product_inventory.table VALUES 
(1, 5),
(2, 8),
(3, 25),
(4, 10),
(5, 3);

-- Step 6: Check if the table was created correctly
SELECT *
FROM bright.product_inventory.table;

SELECT
    product_id,
    stock_qty,
    CASE
        WHEN stock_qty = 0 THEN 'Out of stock'
        WHEN stock_qty BETWEEN 1 AND 5 THEN 'Low Stock'
        WHEN stock_qty > 5 THEN 'In Stock'
    END AS stock_status
FROM bright.product_inventory.table;
