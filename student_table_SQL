--Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

--Step 2: Creat a Schema 
CREATE SCHEMA IF NOT EXISTS bright.student;

--Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.student.table;

--Step 4: Create a Table 
CREATE TABLE IF NOT EXISTS bright.student.table (
student_ID INT,
student_name STRING,
suject_name STRING,
score INT
);

