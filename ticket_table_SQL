-- Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS bright.tickets;

-- Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.tickets.table;

-- Step 4: Create a Table
CREATE TABLE IF NOT EXISTS bright.tickets.table (
    ticket_ID INT,
    issue_type STRING,
    prioritY INT
    );

-- Step 5: Insert the information into the table
INSERT INTO bright.tickets.table VALUES
(1, 'Login issue', 1),
(2, 'Server down', 3),
(3, 'Slow system', 2),
(4, 'Email error', 2),
(5, 'Password reset', 1);

-- Step 6: Check if the table was created correctly
SELECT *
FROM bright.tickets.table;

SELECT
    ticket_ID,
    issus_type,
    prioritY,
    CASE
        WHEN prioritY = 3 THEN 'High'
        WHEN prioritY = 2 THEN 'Medium'
        WHEN prioritY = 1 THEN 'Low'
    END AS priority_label
FROM bright.tickets.table;
